module

public import Mathlib.Analysis.InnerProductSpace.Calculus
public import Mathlib.Analysis.InnerProductSpace.Symmetric
public import Mathlib.LinearAlgebra.Matrix.Hermitian
public import Mathlib.LinearAlgebra.Matrix.Trace
import Mathlib.Analysis.Calculus.Deriv.Pow
import Mathlib.Analysis.Calculus.Deriv.Mul
import Mathlib.Analysis.Calculus.Deriv.Add

@[expose] public section

namespace FQChem.Dynamics

open Matrix
open scoped InnerProductSpace ComplexConjugate

variable {n m : Type*} [Fintype n] [DecidableEq n] [Fintype m] [DecidableEq m]

/-- Schrödinger and Heisenberg propagation give the same expectation trace. -/
def PictureDuality (U ρ O : Matrix n n ℂ) : Prop :=
  (U * ρ * Uᴴ * O).trace = (ρ * (Uᴴ * O * U)).trace

/-- A Heisenberg rotation generated by an involutory Pauli string branches an
anticommuting string into exactly two terms. For an angle `θ`, take
`a = cos (θ / 2)` and `b = I * sin (θ / 2)`. -/
def PauliRotation (P Q : Matrix n n ℂ) (a b : ℂ) : Prop :=
  P * P = 1 → Q * P = -(P * Q) →
    (a • 1 + b • P) * Q * (a • 1 - b • P) =
      (a * a + b * b) • Q + (2 * a * b) • (P * Q)

omit [DecidableEq n] in
theorem pictureDuality (U ρ O : Matrix n n ℂ) : PictureDuality U ρ O := by
  unfold PictureDuality
  simp only [Matrix.mul_assoc]
  rw [trace_mul_comm U, Matrix.mul_assoc, Matrix.mul_assoc]

theorem pauliRotation (P Q : Matrix n n ℂ) (a b : ℂ) : PauliRotation P Q a b := by
  intro hP hcomm
  have hPQP : (P * Q) * P = -Q := by
    rw [Matrix.mul_assoc, hcomm, Matrix.mul_neg, ← Matrix.mul_assoc, hP, one_mul]
  simp only [add_mul, mul_sub, smul_mul_assoc, mul_smul_comm, one_mul, mul_one,
    hcomm, hPQP, smul_neg, add_smul]
  module

end FQChem.Dynamics
