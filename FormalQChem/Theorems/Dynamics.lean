module

public import Mathlib.Analysis.InnerProductSpace.Calculus
public import Mathlib.Analysis.InnerProductSpace.Symmetric
public import Mathlib.LinearAlgebra.Matrix.Hermitian
public import Mathlib.LinearAlgebra.Matrix.Trace

/-! # Finite-basis quantum dynamics and molecular trajectories -/

@[expose] public section

namespace FormalQChem.Dynamics

open Matrix
open scoped InnerProductSpace ComplexConjugate

variable {n m : Type*} [Fintype n] [DecidableEq n] [Fintype m] [DecidableEq m]

/-- The symmetric split propagator (potential half step, kinetic step,
potential half step) is isometric when its substeps are isometric. -/
def SplitOperator (V T : Matrix n n ℂ) : Prop :=
  Vᴴ * V = 1 → Tᴴ * T = 1 →
  (V * T * V)ᴴ * (V * T * V) = 1

/-- If a Krylov basis spans an invariant subspace, the reduced Hamiltonian
reproduces every monomial action on that basis, at any order. -/
def KrylovExact (H : Matrix n n ℂ) (Q : Matrix n m ℂ) (K : Matrix m m ℂ) : Prop :=
  H * Q = Q * K → ∀ k : ℕ, H ^ k * Q = Q * K ^ k

/-- If the first `d + 1` Krylov vectors lie in an orthonormal trial basis,
Galerkin propagation in that basis reproduces the degree-`d` Hamiltonian
monomial on the seed vector. Membership is expressed by the projector `Q Q†`
fixing each vector. -/
def KrylovMoment (H : Matrix n n ℂ) (Q : Matrix n m ℂ) (v : Matrix n (Fin 1) ℂ)
    (d : ℕ) : Prop :=
  (∀ j ≤ d, (Q * Qᴴ) * (H ^ j * v) = H ^ j * v) →
    Q * ((Qᴴ * H * Q) ^ d * (Qᴴ * v)) = H ^ d * v

/-- Schrödinger and Heisenberg propagation give the same expectation trace. -/
def PictureDuality (U ρ O : Matrix n n ℂ) : Prop :=
  (U * ρ * Uᴴ * O).trace = (ρ * (Uᴴ * O * U)).trace

/-- A Heisenberg rotation generated by an involutory Pauli string branches an
anticommuting string into exactly two terms. For an angle `θ`, take
`a = cos (θ / 2)` and `b = I * sin (θ / 2)`. -/
def PauliRotation (P Q : Matrix n n ℂ) (a b : ℂ) : Prop :=
  P * P = 1 → Q * P = -(P * Q) →
    (a • 1 + b • P) * Q * (a • 1 - b • P) =
      (a * a + b * b) • Q + (2 * a * b) • (P * Q)

/-- Each Lindblad dissipator has zero trace. The anticommutator term is
written with a scalar one-half. -/
def LindbladTrace (L ρ : Matrix n n ℂ) : Prop :=
  (L * ρ * Lᴴ - (1 / 2 : ℂ) • (Lᴴ * L * ρ + ρ * (Lᴴ * L))).trace = 0

/-- A finite Kraus channel obeying the completeness relation preserves trace. -/
def KrausTrace {a : Type*} [Fintype a] (K : a → Matrix n n ℂ) (ρ : Matrix n n ℂ) : Prop :=
  (∑ i, (K i)ᴴ * K i) = 1 → (∑ i, K i * ρ * (K i)ᴴ).trace = ρ.trace

/-- Along a one-coordinate Born–Oppenheimer Newton trajectory on a
differentiable adiabatic energy surface, total mechanical energy is stationary. -/
def BornOppenheimerEnergy (mass : ℝ) (q v U : ℝ → ℝ) (t force : ℝ) : Prop :=
  0 < mass → HasDerivAt q (v t) t → HasDerivAt v (force / mass) t →
  HasDerivAt U (-force) (q t) →
  HasDerivAt (fun s => mass * (v s) ^ 2 / 2 + U (q s)) 0 t

/-- An invariant differentiable energy model gives the same directional
force at symmetry-related configurations and correspondingly transformed
displacements. Orthogonal transforms include rotations and atom relabelings. -/
def InvariantDirectionalForce {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
    (E : V → ℝ) (R : V ≃ₗᵢ[ℝ] V) (q : V) : Prop :=
  (∀ p, E (R p) = E p) → DifferentiableAt ℝ E (R q) →
  ∀ δ, -(fderiv ℝ E (R q) (R δ)) = -(fderiv ℝ E q δ)

/-- Harmonic spring forces cancel in the sum over beads of a ring polymer.
For a cycle, the neighbor permutation and its inverse pick the two neighbors. -/
def RingPolymerSpringForce {b : Type*} [Fintype b] (next : Equiv.Perm b)
    (q : b → ℝ) (spring : ℝ) : Prop :=
  ∑ i, spring * (q (next i) + q (next.symm i) - 2 * q i) = 0

/-- In fixed-basis time-dependent CI with a real symmetric Hamiltonian,
the coupled real and imaginary coefficient equations preserve norm squared
to first order. The Hamiltonian may vary in time. -/
def TDConfigurationInteraction {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]
    (H : V →ₗ[ℝ] V) (a b : ℝ → V) (t : ℝ) : Prop :=
  H.IsSymmetric → HasDerivAt a (H (b t)) t → HasDerivAt b (-H (a t)) t →
    HasDerivAt (fun s => ⟪a s, a s⟫_ℝ + ⟪b s, b s⟫_ℝ) 0 t

/-- The empirical tangent covariance of real logarithmic derivatives in
time-dependent VMC is positive semidefinite. Its quadratic form is the
weighted sum of squared directional fluctuations. -/
def SampledTangentMetric {s p : Type*} [Fintype s] [Fintype p]
    (weight : s → ℝ) (O : s → p → ℝ) (direction : p → ℝ) : Prop :=
  (∀ i, 0 ≤ weight i) →
  let centered := fun i j => O i j - ∑ k, weight k * O k j
  let covariance := fun j k => ∑ i, weight i * centered i j * centered i k
  0 ≤ ∑ j, ∑ k, direction j * covariance j k * direction k

/-- McLachlan's projected velocity minimizes the instantaneous residual
over the tangent space of a variational ansatz. -/
def McLachlanProjection {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]
    (T : Submodule ℝ V) (exactVelocity trialVelocity : V) : Prop :=
  trialVelocity ∈ T →
  (∀ w ∈ T, ⟪exactVelocity - trialVelocity, w⟫_ℝ = 0) →
  ∀ v ∈ T, ‖exactVelocity - trialVelocity‖ ^ 2 ≤ ‖exactVelocity - v‖ ^ 2

end FormalQChem.Dynamics
